# Copy to .env beside this file for local API development.
# Production hosts should inject secrets through their environment manager.
# Production requires HTTPS for Supabase, the web origin, and OAuth callback.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=3100
DASHBOARD_WEB_ORIGIN=http://localhost:5173

# Discord user OAuth is optional locally. Register this exact callback URI in
# the Discord Developer Portal before enabling login. Never use the bot token.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=
# Example local callback: http://localhost:3100/api/v1/auth/discord/callback
# Keep dashboard sessions for 30 days; encrypted server-side session records
# are stored under data/ and survive API restarts.
DASHBOARD_SESSION_TTL_SECONDS=2592000
DASHBOARD_MAX_SESSIONS=2000
# Optional private loopback bridge. Copy the same random secret into Argus/.env.
# Generate at least 32 random characters; never commit the actual secret.
DASHBOARD_ACTION_BRIDGE_SECRET=
DASHBOARD_ACTION_BRIDGE_URL=http://127.0.0.1:3120/v1/tracking/actions
# Optional authenticated bot heartbeat. Copy the matching secret to Argus/.env.
DASHBOARD_BOT_HEARTBEAT_TOKEN=
DASHBOARD_BOT_HEARTBEAT_TTL_SECONDS=900
# Comma-separated Discord user IDs allowed to view website-wide admin pages.
DASHBOARD_ADMIN_USER_IDS=
